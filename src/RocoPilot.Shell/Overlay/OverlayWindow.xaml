<Window x:Class="RocoPilot.Shell.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RocoPilot OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei"
        Width="400"
        Height="100">

  <Border x:Name="Island"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          Margin="0,6,0,0"
          Width="200" Height="36" CornerRadius="18"
          Background="#FF000000"
          BorderBrush="#14FFFFFF" BorderThickness="1"
          RenderTransformOrigin="0.5,0">
    <Border.RenderTransform>
      <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1" />
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect Color="#FF000000" BlurRadius="16" ShadowDepth="2" Opacity="0.45" Direction="270" />
    </Border.Effect>

    <Grid>

      <Grid x:Name="CompactLayer" Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#FF94A3B8" VerticalAlignment="Center" />

          <TextBlock x:Name="PhaseText" Text="待机" Margin="9,0,0,0"
                     FontSize="15" FontWeight="Bold"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center">
            <TextBlock.RenderTransform>
              <TranslateTransform x:Name="PhaseShift" Y="0" />
            </TextBlock.RenderTransform>
          </TextBlock>
        </StackPanel>

        <TextBlock x:Name="SceneText" Grid.Column="2" Text="—"
                   FontSize="15" FontWeight="SemiBold" Foreground="#99FFFFFF" VerticalAlignment="Center" />
      </Grid>

      <Grid x:Name="ExpandedLayer" Opacity="0" Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ExpIcon" Grid.Column="0" Text="⚠️"
                   FontSize="22" VerticalAlignment="Center" />

        <StackPanel x:Name="ExpText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="ExpTitle" Text="—"
                     FontSize="15" FontWeight="Bold"
                     Foreground="#FFFFFFFF" />
          <TextBlock x:Name="ExpSubtitle" Text="—" Margin="0,2,0,0"
                     FontSize="11" Foreground="#B3FFFFFF" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
