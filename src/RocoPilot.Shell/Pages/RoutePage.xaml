<Page x:Class="RocoPilot.Shell.Pages.RoutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RocoPilot.Shell.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Grid Margin="32,24,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <ui:Button x:Name="AddAnchorButton" Icon="{ui:SymbolIcon Add24}" Content="添加锚点"
                   ToolTip="添加锚点节点（传送引导）" Click="OnAddAnchorClick" />
        <ui:Button x:Name="AddPlaybackButton" Icon="{ui:SymbolIcon Add24}" Content="添加回放" Margin="8,0,0,0"
                   ToolTip="添加回放节点（重放录制路线）" Click="OnAddPlaybackClick" />
        <ui:Button x:Name="AddLoopButton" Icon="{ui:SymbolIcon Add24}" Content="添加循环" Margin="8,0,0,0"
                   ToolTip="添加循环节点（整图重复）" Click="OnAddLoopClick" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button x:Name="RunButton" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Content="运行"
                   Click="OnRunClick" />
        <ui:Button x:Name="StopButton" Icon="{ui:SymbolIcon Stop24}" Content="停止" Margin="8,0,0,0"
                   IsEnabled="False" Click="OnStopClick" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="8" BorderThickness="1"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid>
        <controls:RouteGraphCanvas x:Name="GraphCanvas" />
        <Border x:Name="RecordingBanner" Visibility="Collapsed"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,16,0,0" Padding="16,8" CornerRadius="8"
                Background="{ui:ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ui:ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{ui:ThemeResource SystemFillColorCriticalBrush}" />
            <ui:TextBlock Margin="8,0,0,0" Text="录制中，按 X 结束" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ui:TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" FontTypography="Caption"
                  Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                  Text="就绪——添加节点，双击配置参数，从节点右侧端口拖出连线"
                  TextWrapping="Wrap" />
  </Grid>
</Page>
