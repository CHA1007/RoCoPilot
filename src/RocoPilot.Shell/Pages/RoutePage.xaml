<Page x:Class="RocoPilot.Shell.Pages.RoutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Grid Margin="{StaticResource PagePadding}">
    <Grid x:Name="TimelineHost" MaxWidth="880" Margin="0,0,0,24" />

    <Border x:Name="Toast" Visibility="Collapsed"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="0,0,0,16" Padding="16,8" CornerRadius="8"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
      <ui:TextBlock x:Name="ToastText" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Page>
