<Page x:Class="RocoPilot.Shell.Pages.RoutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RocoPilot.Shell.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,40">

      <Border CornerRadius="8" BorderThickness="1"
              BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid>
          <controls:RouteLineView x:Name="LineView" />
          <Border x:Name="RecordingBanner" Visibility="Collapsed"
                  VerticalAlignment="Top" HorizontalAlignment="Center"
                  Margin="0,16,0,0" Padding="16,8" CornerRadius="8"
                  Background="{ui:ThemeResource SystemFillColorCriticalBackgroundBrush}"
                  BorderBrush="{ui:ThemeResource SystemFillColorCriticalBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                       Fill="{ui:ThemeResource SystemFillColorCriticalBrush}" />
              <ui:TextBlock Margin="8,0,0,0" Text="录制中，按 X 结束" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ui:TextBlock x:Name="StatusText" Margin="0,12,0,0" FontTypography="Caption"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
