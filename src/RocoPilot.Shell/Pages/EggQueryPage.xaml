<Page x:Class="RocoPilot.Shell.Pages.EggQueryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:RocoPilot.Shell.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Page.Resources>
    <Style x:Key="ChipStyle" TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChipBorder"
                    Padding="12,5"
                    Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ChipDot"
                         Width="8"
                         Height="8"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         Fill="{Binding Dot}" />
                <TextBlock x:Name="ChipText"
                           Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                           Text="{Binding Label}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Dot}" Value="{x:Null}">
                <Setter TargetName="ChipDot" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="1.5" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="ChipBorder" Property="Background" Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
                <Setter TargetName="ChipText" Property="Foreground" Value="White" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="12,12,12,4"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>
        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
          <ui:AutoSuggestBox x:Name="SearchBox"
                             Width="260"
                             Margin="0,0,12,8"
                             PlaceholderText="输入编号或名称，最多选 2 只"
                             QuerySubmitted="OnQuerySubmitted"
                             SuggestionChosen="OnSuggestionChosen"
                             TextChanged="OnSearchTextChanged" />

          <ui:TextBlock x:Name="SearchHint"
                        Margin="0,0,12,8"
                        VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                        Visibility="Collapsed" />

          <ItemsControl x:Name="SelectedPetChips" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,8"
                        Padding="8,4"
                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <StackPanel Orientation="Horizontal">
                    <controls:PetImage Width="22"
                                       Height="22"
                                       SourceUrl="{Binding ImageUrl}" />
                    <TextBlock Margin="6,0,2,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                               Text="{Binding DisplayName}" />
                    <ui:Button Padding="4,2"
                               Appearance="Transparent"
                               Click="OnRemoveSelectedPetClick"
                               Icon="{ui:SymbolIcon Dismiss12}"
                               Tag="{Binding}"
                               ToolTip="移除" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ui:TextBlock x:Name="PairVerdict"
                        Margin="4,0,0,8"
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
        </WrapPanel>

        <ItemsControl x:Name="GroupChips">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="OnGroupChipClick"
                      Style="{StaticResource ChipStyle}"
                      Tag="{Binding Value}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Margin="0,2,0,0">
          <StackPanel Margin="0,0,20,6" Orientation="Horizontal">
            <ui:TextBlock Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="组合" />
            <ItemsControl x:Name="ModeChips">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="OnModeChipClick"
                          Style="{StaticResource ChipStyle}"
                          Tag="{Binding Value}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Margin="0,0,20,6" Orientation="Horizontal">
            <ui:TextBlock Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="形态" />
            <ItemsControl x:Name="StageChips">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="OnStageChipClick"
                          Style="{StaticResource ChipStyle}"
                          Tag="{Binding Value}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <ui:TextBlock Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="异色" />
            <ItemsControl x:Name="ShinyChips">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="OnShinyChipClick"
                          Style="{StaticResource ChipStyle}"
                          Tag="{Binding Value}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </WrapPanel>

        <TextBlock Margin="0,2,0,6"
                   FontSize="11"
                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
          <Run Text="精灵数据与立绘来源：" />
          <Hyperlink Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                     NavigateUri="https://wiki.biligame.com/rocom/"
                     RequestNavigate="OnWikiLinkNavigate">洛克王国:手游 WIKI</Hyperlink>
          <Run Text=" · CC BY-NC-SA 4.0" />
        </TextBlock>
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="0,12,0,8"
            Padding="12,5"
            HorizontalAlignment="Center"
            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14">
      <StackPanel Orientation="Horizontal">
        <ui:TextBlock x:Name="ResultSummary"
                      FontTypography="Caption"
                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        <ui:TextBlock x:Name="ResultCount"
                      Margin="8,0,0,0"
                      FontTypography="Caption"
                      Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
      </StackPanel>
    </Border>

    <ui:TextBlock x:Name="EmptyHint"
                  Grid.Row="2"
                  Margin="0,48,0,0"
                  HorizontalAlignment="Center"
                  FontTypography="Body"
                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                  Visibility="Collapsed" />

    <ItemsControl x:Name="ResultList" Grid.Row="2">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <controls:CenteredWrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Width="104"
                Margin="0,0,10,10"
                Cursor="Hand"
                MouseLeftButtonUp="OnResultCardClick">
            <Grid.RenderTransform>
              <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Duration="0:0:0.14"
                                           To="-3"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                            <DoubleAnimation.EasingFunction>
                              <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                          </DoubleAnimation>
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Duration="0:0:0.14"
                                           To="0"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" />
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.ExitActions>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Border Margin="3,3,0,0" Background="{Binding Glow}" CornerRadius="8" />
            <Border Margin="0,0,3,3"
                    Padding="8"
                    Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
              </Style>
            </Border.Style>
            <StackPanel>
              <Grid Height="84">
                <ui:SymbolIcon HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                               Opacity="0.35"
                               Symbol="FoodEgg24">
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasImage, ElementName=CardArt}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <controls:PetImage x:Name="CardArt"
                                   HorizontalAlignment="Center"
                                   SourceUrl="{Binding ImageUrl}"
                                   Stretch="Uniform" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <TextBlock FontSize="10"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           Text="{Binding IndexLabel}" />
                <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding Dots}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Ellipse Width="7"
                               Height="7"
                               Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               Fill="{Binding Fill}"
                               ToolTip="{Binding Group}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <TextBlock FontSize="12"
                         Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Name}" />
            </StackPanel>
            </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Page>
