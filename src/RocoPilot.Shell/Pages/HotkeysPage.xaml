<Page x:Class="RocoPilot.Shell.Pages.HotkeysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Page.Resources>
    <GridLength x:Key="ScopeColumnWidth">154</GridLength>
    <GridLength x:Key="KeyColumnWidth">138</GridLength>
  </Page.Resources>

  <StackPanel Margin="{StaticResource PagePadding}">

    <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>

        <Grid Margin="16,12,16,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ScopeColumnWidth}" />
            <ColumnDefinition Width="{StaticResource KeyColumnWidth}" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="截图器开启/关闭" />
          <ComboBox Grid.Column="1" Margin="24,0,0,0" x:Name="CaptureScopeBox"
                    Height="34" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="全局热键" />
            <ComboBoxItem Content="游戏内热键" />
          </ComboBox>
          <ui:Button Grid.Column="2" Margin="8,0,0,0" x:Name="CaptureToggleButton"
                     Height="34" Width="130" Content="未指定"
                     ToolTip="点击后按下组合键录入，Esc 清除" />
        </Grid>

        <Separator Margin="16,0" BorderThickness="0,1,0,0" />

        <Grid Margin="16,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ScopeColumnWidth}" />
            <ColumnDefinition Width="{StaticResource KeyColumnWidth}" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="自动丢球开关" />
          <ComboBox Grid.Column="1" Margin="24,0,0,0" x:Name="AutoThrowScopeBox"
                    Height="34" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="全局热键" />
            <ComboBoxItem Content="游戏内热键" />
          </ComboBox>
          <ui:Button Grid.Column="2" Margin="8,0,0,0" x:Name="AutoThrowToggleButton"
                     Height="34" Width="130" Content="未指定"
                     ToolTip="点击后按下组合键录入，Esc 清除" />
        </Grid>

        <Separator Margin="16,0" BorderThickness="0,1,0,0" />

        <Grid Margin="16,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ScopeColumnWidth}" />
            <ColumnDefinition Width="{StaticResource KeyColumnWidth}" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="自动战斗开关" />
          <ComboBox Grid.Column="1" Margin="24,0,0,0" x:Name="AutoBattleScopeBox"
                    Height="34" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="全局热键" />
            <ComboBoxItem Content="游戏内热键" />
          </ComboBox>
          <ui:Button Grid.Column="2" Margin="8,0,0,0" x:Name="AutoBattleToggleButton"
                     Height="34" Width="130" Content="未指定"
                     ToolTip="点击后按下组合键录入，Esc 清除" />
        </Grid>

        <Separator Margin="16,0" BorderThickness="0,1,0,0" />

        <Grid Margin="16,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ScopeColumnWidth}" />
            <ColumnDefinition Width="{StaticResource KeyColumnWidth}" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="地图快传开关" />
          <ComboBox Grid.Column="1" Margin="24,0,0,0" x:Name="FastTravelScopeBox"
                    Height="34" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="全局热键" />
            <ComboBoxItem Content="游戏内热键" />
          </ComboBox>
          <ui:Button Grid.Column="2" Margin="8,0,0,0" x:Name="FastTravelToggleButton"
                     Height="34" Width="130" Content="未指定"
                     ToolTip="点击后按下组合键录入，Esc 清除" />
        </Grid>

        <Separator Margin="16,0" BorderThickness="0,1,0,0" />

        <Grid Margin="16,10,16,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource ScopeColumnWidth}" />
            <ColumnDefinition Width="{StaticResource KeyColumnWidth}" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="调试叠层开关" />
          <ComboBox Grid.Column="1" Margin="24,0,0,0" x:Name="DebugOverlayScopeBox"
                    Height="34" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="全局热键" />
            <ComboBoxItem Content="游戏内热键" />
          </ComboBox>
          <ui:Button Grid.Column="2" Margin="8,0,0,0" x:Name="DebugOverlayToggleButton"
                     Height="34" Width="130" Content="未指定"
                     ToolTip="点击后按下组合键录入，Esc 清除" />
        </Grid>

      </StackPanel>
    </Border>

  </StackPanel>
</Page>
