<Page x:Class="RocoPilot.Shell.Pages.LaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="32,24,32,40">

    <ui:CardExpander ContentPadding="0" Icon="{ui:SymbolIcon Camera24}">
      <ui:CardExpander.Header>
        <Grid HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <ui:TextBlock FontTypography="Body" Text="截图器" />
            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="截图器启动后才能使用自动丢球等功能，点击展开启动相关配置" />
          </StackPanel>
          <ui:Button x:Name="CaptureButton"
                     Grid.Column="1"
                     Margin="0,0,16,0"
                     Content="启动"
                     Icon="{ui:SymbolIcon Play24}"
                     Click="OnCaptureClick" />
        </Grid>
      </ui:CardExpander.Header>
      <StackPanel>
        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="截图模式" />
          <ui:TextBlock Grid.Row="1"
                        Grid.Column="0"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="选择屏幕捕获使用的 API" />
          <ComboBox x:Name="BackendCombo"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="260"
                    SelectionChanged="OnBackendChanged">
            <ComboBoxItem Content="BitBlt" />
            <ComboBoxItem Content="WindowsGraphicsCapture" />
          </ComboBox>
        </Grid>
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</Page>
