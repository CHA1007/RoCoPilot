<Page x:Class="RocoPilot.Shell.Pages.LaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:RocoPilot.Shell.Controls">

  <Grid Background="{DynamicResource NeuBase}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="{StaticResource PagePadding}">

        <controls:NeuExpander Style="{StaticResource NeuExpander}">
          <controls:NeuExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource NeuTextPrimary}" Text="截图器" />
              <ui:TextBlock Foreground="{DynamicResource NeuTextSecondary}"
                            Text="截图器启动后才能使用自动丢球等功能，点击展开启动相关配置" />
            </StackPanel>
          </controls:NeuExpander.Header>
          <controls:NeuExpander.Trailing>
            <Button x:Name="CaptureButton"
                    Style="{StaticResource NeuButton}"
                    Padding="14,7"
                    Click="OnCaptureClick">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon x:Name="CaptureButtonIcon" Symbol="Play24" FontSize="14" />
                <TextBlock x:Name="CaptureButtonText" Margin="6,0,0,0" Text="启动" />
              </StackPanel>
            </Button>
          </controls:NeuExpander.Trailing>
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource NeuTextPrimary}" Text="截图模式" />
                <ui:TextBlock Foreground="{DynamicResource NeuTextSecondary}" Text="选择屏幕捕获使用的 API" />
              </StackPanel>
              <ComboBox x:Name="BackendCombo"
                        Grid.Column="1"
                        Width="260"
                        VerticalAlignment="Center"
                        SelectionChanged="OnBackendChanged">
                <ComboBoxItem Content="BitBlt" />
                <ComboBoxItem Content="WindowsGraphicsCapture" />
                <ComboBoxItem Content="WindowsGraphicsCapture (HDR)" />
                <ComboBoxItem Content="DwmGetDxSharedSurface" />
              </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource NeuTextPrimary}" Text="推理设备" />
                <ui:TextBlock Foreground="{DynamicResource NeuTextSecondary}" Text="GPU（DirectML）速度更快，CPU 兼容性更好" />
              </StackPanel>
              <ComboBox x:Name="DeviceCombo"
                        Grid.Column="1"
                        Width="260"
                        VerticalAlignment="Center"
                        SelectionChanged="OnDeviceChanged">
                <ComboBoxItem Content="CPU" />
                <ComboBoxItem Content="GPU (DirectML)" />
              </ComboBox>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource NeuTextPrimary}" Text="触发器间隔（毫秒）" />
                <ui:TextBlock Foreground="{DynamicResource NeuTextSecondary}" Text="两次推理之间的最小间隔，0＝每帧都跑" />
              </StackPanel>
              <ui:NumberBox x:Name="IntervalBox"
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="5000"
                            SmallChange="50"
                            MaxDecimalPlaces="0"
                            ValidationMode="InvalidInputOverwritten"
                            ValueChanged="OnIntervalChanged" />
            </Grid>
          </StackPanel>
        </controls:NeuExpander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
