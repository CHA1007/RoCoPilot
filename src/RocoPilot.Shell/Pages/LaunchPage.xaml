<Page x:Class="RocoPilot.Shell.Pages.LaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="32,24,32,40">

    <ui:CardExpander ContentPadding="0" Icon="{ui:SymbolIcon Camera24}">
      <ui:CardExpander.Header>
        <Grid HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <ui:TextBlock FontTypography="Body" Text="截图器" />
            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="开启后在游戏窗口上显示覆盖层并实时截图" />
          </StackPanel>
          <ui:ToggleSwitch x:Name="CaptureToggle"
                           Grid.Column="1"
                           Margin="0,0,16,0"
                           Checked="OnCaptureToggled"
                           Unchecked="OnCaptureToggled" />
        </Grid>
      </ui:CardExpander.Header>
      <StackPanel>
        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="截图模式" />
          <ui:TextBlock Grid.Row="1"
                        Grid.Column="0"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="选择屏幕捕获使用的 API" />
          <ComboBox x:Name="BackendCombo"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="260"
                    SelectionChanged="OnBackendChanged">
            <ComboBoxItem Content="WindowsGraphicsCapture" />
            <ComboBoxItem Content="WindowsGraphicsCapture (HDR)" />
            <ComboBoxItem Content="BitBlt (默认)" />
            <ComboBoxItem Content="DwmGetDxSharedSurface" />
          </ComboBox>
        </Grid>
        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="推理设备" />
          <ui:TextBlock Grid.Row="1"
                        Grid.Column="0"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="GPU（DirectML）速度更快，CPU 兼容性更好" />
          <ComboBox x:Name="DeviceCombo"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="260"
                    SelectionChanged="OnDeviceChanged">
            <ComboBoxItem Content="CPU" />
            <ComboBoxItem Content="GPU (DirectML)" />
          </ComboBox>
        </Grid>
        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="触发器间隔（毫秒）" />
          <ui:TextBlock Grid.Row="1"
                        Grid.Column="0"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="两次推理之间的最小间隔，0＝每帧都跑" />
          <ui:NumberBox x:Name="IntervalBox"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Width="140"
                        Minimum="0"
                        Maximum="5000"
                        SmallChange="50"
                        MaxDecimalPlaces="0"
                        ValidationMode="InvalidInputOverwritten"
                        ValueChanged="OnIntervalChanged" />
        </Grid>
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</Page>
