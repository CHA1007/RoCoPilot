<Page x:Class="RocoPilot.Shell.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">
      <ui:TextBlock FontTypography="TitleLarge" Text="设置" />
      <ui:TextBlock Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    Text="外壳设置（settings.json 的 shell 节）" />

      <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon DarkTheme24}">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="主题" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="可选浅色、深色或跟随系统，立即生效并自动保存" />
          </Grid>
        </ui:CardControl.Header>
        <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="OnThemeSelectionChanged">
          <ComboBoxItem Content="跟随系统" />
          <ComboBoxItem Content="浅色" />
          <ComboBoxItem Content="深色" />
        </ComboBox>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Keyboard24}">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="接管热键" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="暂停 / 继续的快捷键，固定为 F12、不可更改" />
          </Grid>
        </ui:CardControl.Header>
        <ui:TextBlock x:Name="HotkeyText"
                      FontTypography="BodyStrong"
                      VerticalAlignment="Center"
                      Text="F12" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Folder24}">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="存储位置" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="你的设置与运行缓存分别存放在以下位置" />
          </Grid>
        </ui:CardControl.Header>
        <ui:TextBlock x:Name="PathsText"
                      FontTypography="Caption"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                      MaxWidth="380" />
      </ui:CardControl>
    </StackPanel>
</Page>
