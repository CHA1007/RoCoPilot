<Page x:Class="RocoPilot.Shell.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="{StaticResource PagePadding}">

      <ui:CardControl>
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="主题" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="切换后立即生效" />
          </Grid>
        </ui:CardControl.Header>
        <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="OnThemeSelectionChanged">
          <ComboBoxItem Content="跟随系统" />
          <ComboBoxItem Content="浅色" />
          <ComboBoxItem Content="深色" />
        </ComboBox>
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="调试叠层" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="在游戏画面上标出识别到的精灵，用于检查识别效果" />
          </Grid>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="DebugOverlayToggle" Checked="OnDebugOverlayChanged" Unchecked="OnDebugOverlayChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="水平灵敏度" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="建议用下方校准自动获取，不准会导致投掷偏移。0 = 用回退值估算" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="SensitivityPpcXBox"
                      Width="200"
                      Minimum="0"
                      Maximum="100"
                      SmallChange="0.1"
                      MaxDecimalPlaces="3"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="垂直灵敏度" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="建议用下方校准自动获取，不准会导致投掷偏移。0 = 用回退值估算" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="SensitivityPpcYBox"
                      Width="200"
                      Minimum="0"
                      Maximum="100"
                      SmallChange="0.1"
                      MaxDecimalPlaces="3"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="自动校准灵敏度" />
            <ui:TextBlock x:Name="CalibrateHint"
                          Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="校准会短暂转动镜头，请先开启截图并保持游戏窗口聚焦" />
          </Grid>
        </ui:CardControl.Header>
        <ui:Button x:Name="CalibrateButton"
                   Content="校准"
                   Click="OnCalibrateClick" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="关于" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="RocoPilot · 洛克工具箱" />
          </Grid>
        </ui:CardControl.Header>
        <StackPanel MinWidth="220">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:TextBlock x:Name="VersionText" VerticalAlignment="Center"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <ui:Button x:Name="CheckUpdateButton" Margin="12,0,0,0"
                       Content="检查更新" Click="OnCheckUpdateClick" />
            <ui:Button x:Name="TestVersionButton" Margin="8,0,0,0"
                       Content="下载测试版" Click="OnDownloadTestClick" />
          </StackPanel>
          <ui:TextBlock x:Name="UpdateStatusText" Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </ui:CardControl>
    </StackPanel>
</Page>
