<Page x:Class="RocoPilot.Shell.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">
      <ui:TextBlock FontTypography="TitleLarge" Text="设置" />
      <ui:TextBlock Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    Text="外壳设置（settings.json 的 shell 节）" />

      <ui:CardControl Margin="0,0,0,12">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="主题" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="可选浅色、深色或跟随系统，立即生效并自动保存" />
          </Grid>
        </ui:CardControl.Header>
        <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="OnThemeSelectionChanged">
          <ComboBoxItem Content="跟随系统" />
          <ComboBoxItem Content="浅色" />
          <ComboBoxItem Content="深色" />
        </ComboBox>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,12">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="接管热键" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="暂停 / 继续的快捷键，固定为 F12、不可更改" />
          </Grid>
        </ui:CardControl.Header>
        <ui:TextBlock x:Name="HotkeyText"
                      FontTypography="BodyStrong"
                      VerticalAlignment="Center"
                      Text="F12" />
      </ui:CardControl>

      <ui:CardControl>
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="存储位置" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="你的设置与运行缓存分别存放在以下位置" />
          </Grid>
        </ui:CardControl.Header>
        <ui:TextBlock x:Name="PathsText"
                      FontTypography="Caption"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                      MaxWidth="380" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="调试叠层" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="在游戏画面上叠加检测框（类名 + 置信度），用于调试识别效果" />
          </Grid>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="DebugOverlayToggle" Checked="OnDebugOverlayChanged" Unchecked="OnDebugOverlayChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="水平灵敏度（像素/count）" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="水平方向每 count 对应的像素数。填 0 则用回退除数。" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="SensitivityPpcXBox"
                      Width="140"
                      Minimum="0"
                      Maximum="100"
                      SmallChange="0.1"
                      MaxDecimalPlaces="3"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="垂直灵敏度（像素/count）" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="垂直方向每 count 对应的像素数。填 0 则用回退除数。" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="SensitivityPpcYBox"
                      Width="140"
                      Minimum="0"
                      Maximum="100"
                      SmallChange="0.1"
                      MaxDecimalPlaces="3"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="转向回退除数" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="灵敏度为 0 时，偏移像素 ÷ 此值 = 转向 count 数。值越小转得越多。" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="FallbackDivisorBox"
                      Width="140"
                      Minimum="1"
                      Maximum="50"
                      SmallChange="0.5"
                      MaxDecimalPlaces="1"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="垂直瞄准偏移" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="框高的比例，负值=往上。补偿检测框包含脚下阴影导致的偏下。" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="AimOffsetYBox"
                      Width="140"
                      Minimum="-0.5"
                      Maximum="0.5"
                      SmallChange="0.05"
                      MaxDecimalPlaces="2"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="自动校准灵敏度" />
            <ui:TextBlock x:Name="CalibrateHint"
                          Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="需先开启截图且游戏窗口聚焦。校准期间会短暂转动镜头。" />
          </Grid>
        </ui:CardControl.Header>
        <ui:Button x:Name="CalibrateButton"
                   Content="校准"
                   Click="OnCalibrateClick" />
      </ui:CardControl>
    </StackPanel>
</Page>
