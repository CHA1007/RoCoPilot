<Page x:Class="RocoPilot.Shell.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">

      <ui:CardControl Margin="0,0,0,12">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="主题" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="切换后立即生效" />
          </Grid>
        </ui:CardControl.Header>
        <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="OnThemeSelectionChanged">
          <ComboBoxItem Content="跟随系统" />
          <ComboBoxItem Content="浅色" />
          <ComboBoxItem Content="深色" />
        </ComboBox>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,12">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="接管热键" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="随时暂停 / 恢复自动丢球，固定 F12" />
          </Grid>
        </ui:CardControl.Header>
        <ui:TextBlock x:Name="HotkeyText"
                      FontTypography="BodyStrong"
                      VerticalAlignment="Center"
                      Text="F12" />
      </ui:CardControl>

      <ui:CardControl>
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="存储位置" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="设置与运行日志的存放位置" />
          </Grid>
        </ui:CardControl.Header>
        <ui:TextBlock x:Name="PathsText"
                      FontTypography="Caption"
                      VerticalAlignment="Center"
                      TextWrapping="Wrap"
                      MaxWidth="380" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="调试叠层" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="在游戏画面上标出识别到的精灵，用于检查识别效果" />
          </Grid>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="DebugOverlayToggle" Checked="OnDebugOverlayChanged" Unchecked="OnDebugOverlayChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="水平灵敏度" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="建议用下方校准自动获取，不准会导致投掷偏移。0 = 用回退值估算" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="SensitivityPpcXBox"
                      Width="140"
                      Minimum="0"
                      Maximum="100"
                      SmallChange="0.1"
                      MaxDecimalPlaces="3"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="垂直灵敏度" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="建议用下方校准自动获取，不准会导致投掷偏移。0 = 用回退值估算" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="SensitivityPpcYBox"
                      Width="140"
                      Minimum="0"
                      Maximum="100"
                      SmallChange="0.1"
                      MaxDecimalPlaces="3"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="转向回退除数" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="灵敏度为 0 时按此值估算转向，值越小转向越多" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="FallbackDivisorBox"
                      Width="140"
                      Minimum="1"
                      Maximum="50"
                      SmallChange="0.5"
                      MaxDecimalPlaces="1"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="垂直瞄准偏移" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="瞄准点相对精灵框的上下偏移，负值朝上" />
          </Grid>
        </ui:CardControl.Header>
        <ui:NumberBox x:Name="AimOffsetYBox"
                      Width="140"
                      Minimum="-0.5"
                      Maximum="0.5"
                      SmallChange="0.05"
                      MaxDecimalPlaces="2"
                      ValidationMode="InvalidInputOverwritten"
                      ValueChanged="OnSensitivityChanged" />
      </ui:CardControl>

      <ui:CardControl Margin="0,12,0,0">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="自动校准灵敏度" />
            <ui:TextBlock x:Name="CalibrateHint"
                          Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="校准会短暂转动镜头，请先开启截图并保持游戏窗口聚焦" />
          </Grid>
        </ui:CardControl.Header>
        <ui:Button x:Name="CalibrateButton"
                   Content="校准"
                   Click="OnCalibrateClick" />
      </ui:CardControl>
    </StackPanel>
</Page>
