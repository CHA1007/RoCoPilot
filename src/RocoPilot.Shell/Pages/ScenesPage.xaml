<Page x:Class="RocoPilot.Shell.Pages.ScenesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Grid Margin="32,24,32,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <ui:Button DockPanel.Dock="Right"
                 Margin="16,0,0,0"
                 VerticalAlignment="Top"
                 Content="刷新"
                 Icon="{ui:SymbolIcon ArrowSync24}"
                 Click="OnRefreshClick" />
      <StackPanel>
        <ui:TextBlock FontTypography="TitleLarge" Text="失败现场" />
        <ui:TextBlock Margin="0,6,0,0"
                      FontTypography="Body"
                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Text="触发式留存：投空 / 跑丢 / 标定失败 / 识别突变 → 关键帧 + 检测叠框 + 遥测 sidecar，环形留最近 100。" />
        <ui:TextBlock x:Name="RootPathText"
                      Margin="0,4,0,0"
                      FontTypography="Caption"
                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ui:TextBlock x:Name="SceneCountText"
                        Margin="0,0,0,8"
                        FontTypography="BodyStrong"
                        Text="现场 0 个" />
          <ListBox x:Name="SceneList"
                   Grid.Row="1"
                   DisplayMemberPath="Label"
                   SelectionChanged="OnSceneSelected" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Margin="16,0,0,0"
              Padding="12"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton x:Name="OverlayRadio"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Content="叠框图"
                           IsChecked="True"
                           Checked="OnOverlayChecked" />
              <RadioButton x:Name="KeyframeRadio"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Content="关键帧"
                           Checked="OnKeyframeChecked" />
            </StackPanel>
            <ui:TextBlock x:Name="SceneTitleText"
                          VerticalAlignment="Center"
                          FontTypography="BodyStrong"
                          Text="尚未留存现场" />
          </DockPanel>
          <Border Grid.Row="1"
                  Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                  CornerRadius="4">
            <Image x:Name="SceneImage" Stretch="Uniform" />
          </Border>
          <Border Grid.Row="2"
                  Margin="0,8,0,0"
                  CornerRadius="4"
                  Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
            <TextBox x:Name="SidecarText"
                     MaxHeight="200"
                     Padding="10,8,10,8"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     Text="（选中左侧现场查看遥测 sidecar）" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
