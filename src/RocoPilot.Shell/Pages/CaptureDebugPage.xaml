<Page x:Class="RocoPilot.Shell.Pages.CaptureDebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,40" MaxWidth="980" HorizontalAlignment="Left">
      <ui:TextBlock FontTypography="TitleLarge" Text="捕获调试" />
      <ui:TextBlock Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="屏幕捕获腿的诊断面：按窗口标题子串锁定目标（回退链「窗口 WGC → 整屏 WGC → GDI」），实时显示帧、FPS 与当前后端。纯外部只读截取，不涉注入 / Hook。" />

      <Border Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="目标窗口（标题子串）" />
          <DockPanel>
            <ui:Button x:Name="StartButton"
                       DockPanel.Dock="Right"
                       Margin="8,0,0,8"
                       Appearance="Primary"
                       Content="开始捕获"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="OnStartClick" />
            <ui:Button x:Name="StopButton"
                       DockPanel.Dock="Right"
                       Margin="8,0,0,8"
                       Content="停止"
                       Icon="{ui:SymbolIcon Stop24}"
                       IsEnabled="False"
                       Click="OnStopClick" />
            <ui:TextBox x:Name="WindowTitleBox"
                        Margin="0,0,0,8"
                        PlaceholderText="如：洛克王国（留空＝直接整屏捕获）"
                        Text="洛克王国" />
          </DockPanel>
          <DockPanel>
            <ui:Button DockPanel.Dock="Right"
                       Margin="8,0,0,0"
                       Content="刷新窗口列表"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Click="OnRefreshWindowsClick" />
            <ComboBox x:Name="WindowList"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnWindowSelected" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,48,0" VerticalAlignment="Center">
            <ui:TextBlock x:Name="FpsText"
                          FontTypography="TitleLarge"
                          Text="— FPS" />
            <ui:TextBlock x:Name="FrameCountText"
                          Margin="0,4,0,0"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="累计 0 帧" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock x:Name="BackendText" FontTypography="BodyStrong" Text="后端：未启动" />
            <ui:TextBlock x:Name="SourceText"
                          Margin="0,4,0,0"
                          FontTypography="Body"
                          TextWrapping="Wrap"
                          Text="目标：—" />
            <ui:TextBlock x:Name="ResolutionText"
                          Margin="0,4,0,0"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="分辨率：—" />
            <ui:TextBlock x:Name="StatusText"
                          Margin="0,4,0,0"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="状态：待机" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="8"
              CornerRadius="8"
              Background="#FF000000"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Image x:Name="LiveImage"
               MaxHeight="520"
               HorizontalAlignment="Center"
               Stretch="Uniform" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
