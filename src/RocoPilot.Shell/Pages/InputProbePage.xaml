<Page x:Class="RocoPilot.Shell.Pages.InputProbePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,40" MaxWidth="760" HorizontalAlignment="Left">
      <ui:TextBlock FontTypography="TitleLarge" Text="输入探针" />
      <ui:TextBlock Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="合成输入真机验证（人执行）。② 验证驱动（context 创建成功＝驱动真在设备栈）→ ③ 发探针。游戏聚焦下应转镜头（光标与镜头同动）。" />

      <ui:CardControl Margin="0,0,0,12">
        <ui:CardControl.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="探针移动量（count）" />
            <ui:TextBlock Grid.Row="1"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="相对位移计数；转不动镜头就加大（如 800 / 1200）" />
          </Grid>
        </ui:CardControl.Header>
        <TextBox x:Name="AmountBox" Width="160" Text="400" />
      </ui:CardControl>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
        <ui:Button x:Name="ArmButton"
                   Content="② 验证驱动"
                   Appearance="Primary"
                   Width="150"
                   Margin="0,0,8,0"
                   Click="OnArm" />
        <ui:Button x:Name="ProbeButton"
                   Content="③ 发送探针"
                   Width="150"
                   Margin="0,0,8,0"
                   Click="OnProbe" />
        <ui:Button x:Name="ClickButton"
                   Content="测试左键"
                   Width="120"
                   Click="OnClick" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <ui:Button x:Name="KeyTestButton"
                   Content="测试空格"
                   Width="120"
                   Click="OnKeyTest" />
      </StackPanel>

      <ui:TextBlock FontTypography="BodyStrong" Text="状态" Margin="0,0,0,6" />
      <ui:TextBlock x:Name="StatusText"
                    FontTypography="Body"
                    TextWrapping="Wrap"
                    Text="选好后端，先点「② 验证驱动」。" />
    </StackPanel>
  </ScrollViewer>
</Page>
