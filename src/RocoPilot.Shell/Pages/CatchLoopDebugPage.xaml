<Page x:Class="RocoPilot.Shell.Pages.CatchLoopDebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,40" MaxWidth="980" HorizontalAlignment="Left">
      <ui:TextBlock FontTypography="TitleLarge" Text="捕捉调试" />
      <ui:TextBlock Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="票 07 验证面：四态环自动丢球（SCANNING → CENTERING → THROWING → SETTLING）。无结果分支——present 同锚复投、gone 重选；未捕获的同一只会被反复投。停令 / 暂停在尝试边界收完当前一发宏（~1.3s）即生效。" />

      <Border Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="目标窗口（标题子串）" />
          <DockPanel>
            <ui:Button DockPanel.Dock="Right"
                       Margin="8,0,0,8"
                       Content="刷新窗口列表"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Click="OnRefreshWindowsClick" />
            <ComboBox x:Name="WindowList"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnWindowSelected" />
          </DockPanel>
          <ui:TextBox x:Name="WindowTitleBox"
                      Margin="0,0,0,12"
                      PlaceholderText="如：洛克王国（留空＝直接整屏捕获）"
                      Text="洛克王国" />
          <DockPanel Margin="0,0,0,8">
            <ui:TextBlock DockPanel.Dock="Left"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          FontTypography="Body"
                          Text="输入后端" />
            <ComboBox x:Name="BackendCombo"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0"
                      SelectionChanged="OnBackendChanged">
              <ComboBoxItem Content="interception（真机：转镜头 + 投掷）" />
              <ComboBoxItem Content="sendinput（桌面：动光标，对 Roco 镜头无效）" />
            </ComboBox>
          </DockPanel>
          <DockPanel>
            <ui:TextBlock DockPanel.Dock="Left"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          FontTypography="Body"
                          Text="运行档位" />
            <ComboBox x:Name="ModeCombo"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0"
                      SelectionChanged="OnModeChanged">
              <ComboBoxItem Content="move-only（真转镜头居中、不投球，零球耗）" />
              <ComboBoxItem Content="live（全量真投！人在场，见异色 / 弹窗先暂停）" />
              <ComboBoxItem Content="dry-run（只记录会怎么做，零输入）" />
            </ComboBox>
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <ui:Button x:Name="StartButton"
                       DockPanel.Dock="Left"
                       Appearance="Primary"
                       Content="开始循环"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="OnStartClick" />
            <ui:Button x:Name="StopButton"
                       DockPanel.Dock="Right"
                       Content="停止"
                       Icon="{ui:SymbolIcon Stop24}"
                       IsEnabled="False"
                       Click="OnStopClick" />
            <ui:Button x:Name="PauseResumeButton"
                       DockPanel.Dock="Right"
                       Margin="0,0,8,0"
                       Content="暂停"
                       Icon="{ui:SymbolIcon Pause24}"
                       IsEnabled="False"
                       Click="OnPauseResumeClick" />
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock x:Name="StatusText" FontTypography="BodyStrong" Text="状态：待机" />
          <ui:TextBlock x:Name="StateText"
                        Margin="0,4,0,0"
                        FontTypography="BodyStrong"
                        Text="当前状态：Idle · —" />
          <ui:TextBlock x:Name="StatsText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="投掷 0 · 了结 0 · 投每小时 0 · 居中率 —" />
          <ui:TextBlock x:Name="TimeText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="运行 00:00 · 休息 00:00 · 距上次了结 —" />
          <ui:TextBlock x:Name="BackendText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="捕获后端：未启动" />
          <ui:TextBlock x:Name="LogPathText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="会话日志：—（开始即建于 %LOCALAPPDATA%/RocoPilot/logs/）" />
          <ui:TextBlock x:Name="StallText"
                        Margin="0,8,0,0"
                        FontTypography="BodyStrong"
                        Foreground="#FFC42B1C"
                        Visibility="Collapsed"
                        Text="⚠ stall：无了结已达阈（仅通知，不停机）" />
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock FontTypography="BodyStrong" Text="事件尾（十事件目录全量，新→旧）" />
          <ui:TextBlock x:Name="EventsText"
                        Margin="0,8,0,0"
                        FontTypography="Body"
                        TextWrapping="Wrap"
                        Text="（无事件）" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
