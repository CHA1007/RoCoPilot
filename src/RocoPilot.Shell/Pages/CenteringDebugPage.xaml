<Page x:Class="RocoPilot.Shell.Pages.CenteringDebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,24,32,40" MaxWidth="980" HorizontalAlignment="Left">
      <ui:TextBlock FontTypography="TitleLarge" Text="居中调试" />
      <ui:TextBlock Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="票 06 move-only 验证面：自动循环「发现 → 灵敏度自标定（缓存全场复用）→ 转镜头居中」，只移动不发键、零球耗。日志带 calib 来源 / 残差 px / 步数；序列内绝不换锁；anchor gone / 步数尽自动重选。" />

      <Border Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="目标窗口（标题子串）" />
          <DockPanel>
            <ui:Button DockPanel.Dock="Right"
                       Margin="8,0,0,8"
                       Content="刷新窗口列表"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Click="OnRefreshWindowsClick" />
            <ComboBox x:Name="WindowList"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnWindowSelected" />
          </DockPanel>
          <ui:TextBox x:Name="WindowTitleBox"
                      Margin="0,0,0,12"
                      PlaceholderText="如：洛克王国（留空＝直接整屏捕获）"
                      Text="洛克王国" />
          <DockPanel>
            <ui:TextBlock DockPanel.Dock="Left"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          FontTypography="Body"
                          Text="输入后端" />
            <ui:Button x:Name="StartButton"
                       DockPanel.Dock="Right"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="开始居中循环"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="OnStartClick" />
            <ui:Button x:Name="StopButton"
                       DockPanel.Dock="Right"
                       Margin="8,0,0,0"
                       Content="停止"
                       Icon="{ui:SymbolIcon Stop24}"
                       IsEnabled="False"
                       Click="OnStopClick" />
            <ComboBox x:Name="BackendCombo"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0"
                      SelectionChanged="OnBackendChanged">
              <ComboBoxItem Content="interception（真机：转镜头）" />
              <ComboBoxItem Content="sendinput（桌面：动光标，对 Roco 镜头无效）" />
            </ComboBox>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock x:Name="StatusText" FontTypography="BodyStrong" Text="状态：待机" />
          <ui:TextBlock x:Name="BackendText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="捕获后端：未启动" />
          <ui:TextBlock x:Name="StatsText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="尝试 0 · 居中 0 · 居中率 —" />
          <ui:TextBlock x:Name="PpcText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="ppc 缓存：无（首次居中前自标定）" />
          <ui:TextBlock x:Name="ParamsText"
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="参数：—（读 settings.json tools.auto-throw）" />
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="8"
              CornerRadius="8"
              Background="#FF000000"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Image x:Name="SnapshotImage"
               MaxHeight="460"
               HorizontalAlignment="Center"
               Stretch="Uniform" />
      </Border>

      <Border Margin="0,12,0,0"
              Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <ui:TextBlock FontTypography="BodyStrong" Text="尝试记录（最近，新→旧）" />
          <ui:TextBlock x:Name="AttemptsText"
                        Margin="0,8,0,0"
                        FontTypography="Body"
                        TextWrapping="Wrap"
                        Text="（尚未尝试）" />
          <ui:TextBlock Margin="0,14,0,0" FontTypography="BodyStrong" Text="事件尾（calibration / centered / centering_failed）" />
          <ui:TextBlock x:Name="EventsText"
                        Margin="0,8,0,0"
                        FontTypography="Body"
                        TextWrapping="Wrap"
                        Text="（无事件）" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
