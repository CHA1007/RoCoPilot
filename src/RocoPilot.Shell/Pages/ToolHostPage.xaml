<Page x:Class="RocoPilot.Shell.Pages.ToolHostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">
      <ui:TextBlock x:Name="TitleText" FontTypography="TitleLarge" Text="工具" />
      <ui:TextBlock x:Name="SubtitleText"
                    Margin="0,6,0,20"
                    FontTypography="Body"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

      <Border Padding="16,14,16,14"
              CornerRadius="8"
              Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>

          <WrapPanel>
            <ui:Button x:Name="StartButton"
                       Margin="0,0,8,8"
                       Appearance="Primary"
                       Content="启动"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="OnStartClick" />
            <ui:Button x:Name="PauseButton"
                       Margin="0,0,8,8"
                       Content="暂停"
                       Icon="{ui:SymbolIcon Pause24}"
                       Click="OnPauseClick" />
            <ui:Button x:Name="ResumeButton"
                       Margin="0,0,8,8"
                       Content="恢复"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="OnResumeClick" />
            <ui:Button x:Name="StopButton"
                       Margin="0,0,8,8"
                       Content="停止"
                       Icon="{ui:SymbolIcon Stop24}"
                       Click="OnStopClick" />
          </WrapPanel>

          <ui:TextBlock x:Name="ArmingHintText"
                        Margin="0,8,0,0"
                        FontTypography="Body"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
          <ui:TextBlock x:Name="ArmingFailureText"
                        Margin="0,8,0,0"
                        FontTypography="Body"
                        Foreground="#FFC42B1C"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

        </StackPanel>
      </Border>

      <ui:TextBlock Margin="0,28,0,12" FontTypography="Subtitle" Text="配置" />

      <ContentControl x:Name="ConfigPanelHost" />
  </StackPanel>
</Page>
