<Page x:Class="RocoPilot.Shell.Pages.ToolHostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Grid Background="{DynamicResource NeuBase}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="720" HorizontalAlignment="Left">
        <ui:TextBlock x:Name="TitleText" FontTypography="TitleLarge" Foreground="{DynamicResource NeuTextPrimary}" Text="工具" />
        <ui:TextBlock x:Name="SubtitleText"
                      Margin="0,6,0,24"
                      FontTypography="Body"
                      Foreground="{DynamicResource NeuTextSecondary}"
                      TextWrapping="Wrap" />

        <ContentControl Style="{StaticResource NeuRaised}" Padding="18,16">
          <StackPanel>

            <WrapPanel>
              <Button x:Name="StartButton"
                      Style="{StaticResource NeuPrimaryButton}"
                      Margin="0,0,14,12"
                      Click="OnStartClick">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Play24" FontSize="15" />
                  <TextBlock Margin="8,0,0,0" Text="启动" />
                </StackPanel>
              </Button>
              <Button x:Name="PauseButton"
                      Style="{StaticResource NeuButton}"
                      Margin="0,0,14,12"
                      Click="OnPauseClick">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Pause24" FontSize="15" />
                  <TextBlock Margin="8,0,0,0" Text="暂停" />
                </StackPanel>
              </Button>
              <Button x:Name="ResumeButton"
                      Style="{StaticResource NeuButton}"
                      Margin="0,0,14,12"
                      Click="OnResumeClick">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Play24" FontSize="15" />
                  <TextBlock Margin="8,0,0,0" Text="恢复" />
                </StackPanel>
              </Button>
              <Button x:Name="StopButton"
                      Style="{StaticResource NeuButton}"
                      Margin="0,0,14,12"
                      Click="OnStopClick">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Stop24" FontSize="15" />
                  <TextBlock Margin="8,0,0,0" Text="停止" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <ContentControl x:Name="StatusWell"
                            Style="{StaticResource NeuSunken}"
                            Margin="0,4,0,0"
                            Padding="14,10"
                            Visibility="Collapsed">
              <StackPanel>
                <ui:TextBlock x:Name="ArmingHintText"
                              FontTypography="Body"
                              Foreground="{DynamicResource NeuTextPrimary}"
                              TextWrapping="Wrap"
                              Visibility="Collapsed" />
                <ui:TextBlock x:Name="ArmingFailureText"
                              FontTypography="Body"
                              Foreground="{DynamicResource NeuDanger}"
                              TextWrapping="Wrap"
                              Visibility="Collapsed" />
              </StackPanel>
            </ContentControl>

          </StackPanel>
        </ContentControl>

        <ui:TextBlock Margin="0,32,0,16" FontTypography="Subtitle" Foreground="{DynamicResource NeuTextPrimary}" Text="配置" />

        <ContentControl x:Name="ConfigPanelHost" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
