<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>

    <ApplicationIcon>RocoPilot.ico</ApplicationIcon>
    <AssemblyName>RocoPilot</AssemblyName>
    <StartupObject>RocoPilot.Shell.App</StartupObject>
    <Version>0.1.0</Version>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.18" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />

    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>

    <Resource Include="RocoPilot.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\templates\**\*" Link="assets\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocoPilot.Capture\RocoPilot.Capture.csproj" />
    <ProjectReference Include="..\RocoPilot.Core\RocoPilot.Core.csproj" />
    <ProjectReference Include="..\RocoPilot.Detection\RocoPilot.Detection.csproj" />
    <ProjectReference Include="..\RocoPilot.Dispatch\RocoPilot.Dispatch.csproj" />
    <ProjectReference Include="..\RocoPilot.Input\RocoPilot.Input.csproj" />
    <ProjectReference Include="..\RocoPilot.Loop\RocoPilot.Loop.csproj" />
    <ProjectReference Include="..\RocoPilot.Settings\RocoPilot.Settings.csproj" />
    <ProjectReference Include="..\RocoPilot.Tools.AutoBattle\RocoPilot.Tools.AutoBattle.csproj" />
    <ProjectReference Include="..\RocoPilot.Tools.AutoThrow\RocoPilot.Tools.AutoThrow.csproj" />
    <ProjectReference Include="..\RocoPilot.Tools.FastTravel\RocoPilot.Tools.FastTravel.csproj" />
  </ItemGroup>

</Project>
