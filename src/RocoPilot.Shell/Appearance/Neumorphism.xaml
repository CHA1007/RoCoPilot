<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:RocoPilot.Shell.Controls">

  <RotateTransform x:Key="NeuChevronCollapsed" Angle="-90" />
  <RotateTransform x:Key="NeuChevronExpanded" Angle="0" />

  <Color x:Key="NeuLightShadowColor">#FF34383F</Color>
  <Color x:Key="NeuDarkShadowColor">#FF16181C</Color>

  <SolidColorBrush x:Key="NeuBase" Color="#FF282B31" />
  <SolidColorBrush x:Key="NeuSunkenFill" Color="#FF22252A" />
  <SolidColorBrush x:Key="NeuTextPrimary" Color="#FFE9EBF1" />
  <SolidColorBrush x:Key="NeuTextSecondary" Color="#FF9AA2B1" />
  <SolidColorBrush x:Key="NeuAccent" Color="#FF5B8DEF" />
  <SolidColorBrush x:Key="NeuOnAccent" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="NeuDanger" Color="#FFFF7A6B" />

  <Style x:Key="NeuRaised" TargetType="ContentControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Background="{DynamicResource NeuBase}" CornerRadius="16">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="135" Opacity="0.9"
                                  Color="{DynamicResource NeuLightShadowColor}" />
              </Border.Effect>
            </Border>
            <Border Background="{DynamicResource NeuBase}" CornerRadius="16">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="315" Opacity="0.55"
                                  Color="{DynamicResource NeuDarkShadowColor}" />
              </Border.Effect>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeuSunken" TargetType="ContentControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource NeuSunkenFill}" CornerRadius="12" BorderThickness="1">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{DynamicResource NeuDarkShadowColor}" />
                <GradientStop Offset="1" Color="{DynamicResource NeuLightShadowColor}" />
              </LinearGradientBrush>
            </Border.BorderBrush>
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="NeuButtonTemplate" TargetType="Button">
    <Grid>
      <Border x:Name="LightShadow" Background="{TemplateBinding Background}" CornerRadius="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="135" Opacity="0.9"
                            Color="{DynamicResource NeuLightShadowColor}" />
        </Border.Effect>
      </Border>
      <Border x:Name="DarkShadow" Background="{TemplateBinding Background}" CornerRadius="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.5"
                            Color="{DynamicResource NeuDarkShadowColor}" />
        </Border.Effect>
      </Border>
      <Border x:Name="HoverOverlay" Background="#0AFFFFFF" CornerRadius="12" Opacity="0" />
      <Border x:Name="PressedOverlay" Background="#1F000000" CornerRadius="12" Opacity="0" BorderThickness="1">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{DynamicResource NeuDarkShadowColor}" />
            <GradientStop Offset="1" Color="{DynamicResource NeuLightShadowColor}" />
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
      <ContentPresenter x:Name="ContentHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}"
                        RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="LightShadow" Property="Opacity" Value="0" />
        <Setter TargetName="DarkShadow" Property="Opacity" Value="0" />
        <Setter TargetName="HoverOverlay" Property="Opacity" Value="0" />
        <Setter TargetName="PressedOverlay" Property="Opacity" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="LightShadow" Property="Opacity" Value="0" />
        <Setter TargetName="DarkShadow" Property="Opacity" Value="0" />
        <Setter TargetName="PressedOverlay" Property="Opacity" Value="1" />
        <Setter TargetName="ContentHost" Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="NeuButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource NeuBase}" />
    <Setter Property="Foreground" Value="{DynamicResource NeuTextPrimary}" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource NeuButtonTemplate}" />
  </Style>

  <Style x:Key="NeuExpander" TargetType="controls:NeuExpander">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:NeuExpander">
          <Grid>
            <Border Background="{DynamicResource NeuBase}" CornerRadius="16">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="135" Opacity="0.9"
                                  Color="{DynamicResource NeuLightShadowColor}" />
              </Border.Effect>
            </Border>
            <Border Background="{DynamicResource NeuBase}" CornerRadius="16">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="315" Opacity="0.55"
                                  Color="{DynamicResource NeuDarkShadowColor}" />
              </Border.Effect>
            </Border>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="Chevron"
                                       Grid.Column="0"
                                       Margin="18,0,10,0"
                                       FontSize="14"
                                       Symbol="ChevronDown24"
                                       Foreground="{DynamicResource NeuTextSecondary}"
                                       RenderTransformOrigin="0.5,0.5"
                                       RenderTransform="{StaticResource NeuChevronCollapsed}" />
                        <ContentPresenter Grid.Column="1"
                                          Margin="0,14,16,14"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform" Value="{StaticResource NeuChevronExpanded}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter Content="{TemplateBinding Header}" />
                </ToggleButton>
                <ContentPresenter Grid.Column="1"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Trailing}" />
              </Grid>
              <Border x:Name="ExpandedContent" Visibility="Collapsed">
                <ContentPresenter Margin="18,2,18,18" Content="{TemplateBinding Content}" />
              </Border>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeuPrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource NeuAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource NeuOnAccent}" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource NeuButtonTemplate}" />
  </Style>

</ResourceDictionary>
