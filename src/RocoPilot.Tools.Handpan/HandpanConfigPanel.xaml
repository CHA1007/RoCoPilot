<UserControl x:Class="RocoPilot.Tools.Handpan.HandpanConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <Grid>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Padding="12"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox x:Name="ScoreSearchBox"
                      PlaceholderText="搜索曲谱"
                      TextChanged="OnSearchTextChanged" />
          <ui:Button x:Name="ImportButton"
                     Grid.Column="1"
                     Width="34" Height="34" Margin="8,0,0,0" Padding="0"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Appearance="Transparent"
                     Icon="{ui:SymbolIcon ArrowImport24}"
                     ToolTip="导入 MIDI"
                     Click="OnImportClick" />
          <ui:Button x:Name="OpenFolderButton"
                     Grid.Column="2"
                     Width="34" Height="34" Margin="8,0,0,0" Padding="0"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Appearance="Transparent"
                     Icon="{ui:SymbolIcon Folder24}"
                     ToolTip="打开曲谱目录"
                     Click="OnOpenFolderClick" />
        </Grid>

        <Grid>
          <ui:ListView x:Name="ScoreList"
                       SelectionChanged="OnScoreSelectionChanged"
                       MouseDoubleClick="OnScoreDoubleClick" />
          <ui:TextBlock x:Name="EmptyHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="曲谱库为空"
                        TextAlignment="Center"
                        Visibility="Collapsed" />
        </Grid>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">

        <ui:Card Padding="20,16,20,16">
          <StackPanel>
            <ui:TextBlock x:Name="SongTitleText"
                          FontTypography="Subtitle"
                          Text="未选择曲谱"
                          TextTrimming="CharacterEllipsis" />
            <ui:TextBlock x:Name="StatusText"
                          Margin="0,2,0,0"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="导入 .mid 文件加入曲谱库"
                          TextWrapping="Wrap" />

            <ProgressBar x:Name="ProgressTrack"
                         Height="4"
                         Margin="0,16,0,6"
                         Maximum="1"
                         BorderThickness="0"
                         Background="{ui:ThemeResource ControlStrokeColorSecondaryBrush}"
                         Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}" />
            <Grid x:Name="ProgressTimeRow" Visibility="Collapsed">
              <ui:TextBlock x:Name="ProgressTimeText"
                            HorizontalAlignment="Left"
                            FontTypography="Caption"
                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
              <ui:TextBlock x:Name="ProgressRoundText"
                            HorizontalAlignment="Right"
                            FontTypography="Caption"
                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>

            <Grid Margin="0,18,0,0">
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button x:Name="PrevButton"
                           Width="40" Height="40" Padding="0"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ChevronLeft24}"
                           ToolTip="上一曲"
                           Click="OnPrevClick" />
                <ui:Button x:Name="PlayButton"
                           Width="52" Height="52" Margin="12,0,12,0" Padding="0"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Play24}"
                           ToolTip="开始演奏"
                           Click="OnPlayClick" />
                <ui:Button x:Name="NextButton"
                           Width="40" Height="40" Padding="0"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon ChevronRight24}"
                           ToolTip="下一曲"
                           Click="OnNextClick" />
              </StackPanel>
              <ui:Button x:Name="StopButton"
                         Width="40" Height="40" Padding="0"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Appearance="Danger"
                         Icon="{ui:SymbolIcon Stop24}"
                         ToolTip="停止"
                         Visibility="Collapsed"
                         Click="OnStopClick" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="移调（半音）" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="把整曲升高或降低若干半音；正数更高、负数更低"
                          TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="TransposeSlider"
                      Grid.Column="0"
                      Minimum="-11" Maximum="11"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding Transpose}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,6,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=TransposeSlider, StringFormat={}{0:+0;-0;0}}" />
              <ui:Button x:Name="AutoFitButton"
                         Grid.Column="2"
                         VerticalAlignment="Center"
                         Content="自动适配"
                         Icon="{ui:SymbolIcon ArrowBidirectionalUpDown24}"
                         ToolTip="按当前曲谱计算最优移调并填入"
                         Click="OnAutoFitClick" />
            </Grid>
            <ui:TextBlock x:Name="TransposeSummaryText"
                          Margin="0,10,0,0"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          TextTrimming="CharacterEllipsis"
                          Visibility="Collapsed" />
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="最小音距（毫秒）" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="相邻两个音至少隔开多久；比它密的连续音会被拉开，稀疏段落不动；0 为不限制"
                          TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="MinIntervalSlider"
                      Grid.Column="0"
                      Minimum="0" Maximum="300"
                      TickFrequency="10" IsSnapToTickEnabled="True"
                      Value="{Binding MinIntervalMs}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=MinIntervalSlider, StringFormat={}{0:0}}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="补击间隔（拍）" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="长音每过几拍补敲一次，补击落在拍上；0 为不补"
                          TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="RestrikeSlider"
                      Grid.Column="0"
                      Minimum="0" Maximum="4"
                      TickFrequency="0.25" IsSnapToTickEnabled="True"
                      Value="{Binding RestrikeIntervalBeats}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=RestrikeSlider, StringFormat={}{0:0.##}}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:ToggleSwitch x:Name="AccompanyToggle"
                             Content="和弦伴奏"
                             IsChecked="{Binding Accompany}" />
            <ui:TextBlock Margin="0,6,0,8"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="复用曲谱自带的和弦声部，量化到固定拍距后垫在旋律下方；单轨曲谱没有可用伴奏"
                          TextWrapping="Wrap" />
            <Grid x:Name="AccompanyRow" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="AccompanyEverySlider"
                      Grid.Column="0"
                      Minimum="0.5" Maximum="4"
                      TickFrequency="0.5" IsSnapToTickEnabled="True"
                      Value="{Binding AccompanyEveryBeats}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=AccompanyEverySlider, StringFormat={}{0:0.#}拍}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock VerticalAlignment="Center"
                            FontTypography="BodyStrong"
                            Text="速度" />
              <ui:ToggleSwitch x:Name="SpeedModeToggle"
                               Grid.Column="1"
                               Content="按百分比"
                               IsChecked="{Binding SpeedByPercent}" />
            </Grid>
            <ui:TextBlock x:Name="BpmHint"
                          Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="按 BPM 固定整曲速度，0 为曲谱原速"
                          TextWrapping="Wrap" />
            <ui:TextBlock x:Name="SpeedPercentHint"
                          Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="以曲谱原速为基准缩放，100% 为原速"
                          TextWrapping="Wrap"
                          Visibility="Collapsed" />
            <Grid x:Name="BpmRow">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="BpmSlider"
                      Grid.Column="0"
                      Minimum="0" Maximum="240"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding BpmOverride}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=BpmSlider, StringFormat={}{0:0}}" />
            </Grid>
            <Grid x:Name="SpeedPercentRow"
                  Margin="0,6,0,0"
                  Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="SpeedPercentSlider"
                      Grid.Column="0"
                      Minimum="50" Maximum="200"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding SpeedPercent}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=SpeedPercentSlider, StringFormat={}{0:0}%}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="倒计时（秒）" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="按下开始后、第一个音出来前的缓冲时间"
                          TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="CountdownSlider"
                      Grid.Column="0"
                      Minimum="0" Maximum="10"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      Value="{Binding CountdownSeconds}" />
              <ui:TextBlock Grid.Column="1"
                            Width="56" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            FontTypography="Body"
                            Text="{Binding Value, ElementName=CountdownSlider, StringFormat={}{0:0}}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="循环演奏" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="整曲结束后自动从头再来，直到手动停止"
                          TextWrapping="Wrap" />
            <ui:ToggleSwitch HorizontalAlignment="Left" IsChecked="{Binding Loop}" />
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="键位自检" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="按键位表逐个按键试音，用来确认音名与按键对应得上"
                          TextWrapping="Wrap" />
            <ui:Button x:Name="ProbeButton"
                       HorizontalAlignment="Left"
                       Content="开始自检"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="OnProbeClick" />
          </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,12,0,0" Padding="16,12,16,14">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="导出按键谱" />
            <ui:TextBlock Margin="0,2,0,10"
                          FontTypography="Caption"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="把当前曲谱的演奏按键序列存成文本"
                          TextWrapping="Wrap" />
            <ui:Button x:Name="ExportButton"
                       HorizontalAlignment="Left"
                       Content="导出"
                       Icon="{ui:SymbolIcon ArrowExportUp24}"
                       Click="OnExportClick" />
          </StackPanel>
        </ui:Card>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
