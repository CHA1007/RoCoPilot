<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RocoPilotSetup</AssemblyName>
    <RootNamespace>RocoPilot.Setup</RootNamespace>
    <ApplicationIcon>..\RocoPilot.Shell\RocoPilot.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PayloadSetup)' == ''">
    <PayloadSetup>..\..\releases\RocoPilot-win-Setup.exe</PayloadSetup>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(PayloadSetup)' != '' and Exists('$(PayloadSetup)')">
    <EmbeddedResource Include="$(PayloadSetup)" LogicalName="RocoPilotSetupPayload" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.png" Link="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocoPilot.Installer.Core\RocoPilot.Installer.Core.csproj" />
  </ItemGroup>

</Project>