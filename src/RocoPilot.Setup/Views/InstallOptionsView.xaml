<UserControl x:Class="RocoPilot.Setup.Views.InstallOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="560">
    <StackPanel Margin="40,32">
        <TextBlock Text="安装选项"
                   FontSize="26" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <TextBlock Margin="0,24,0,8"
                   Text="安装位置"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="InstallPathBox"
                        Grid.Column="0"
                        Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="40" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="浏览…"
                    MinWidth="88"
                    Click="Browse_Click" />
        </Grid>

        <ui:Card Margin="0,20,0,0" Padding="16">
            <StackPanel>
                <CheckBox x:Name="DesktopShortcutBox"
                          Content="创建桌面快捷方式"
                          FontSize="14" />
                <CheckBox x:Name="LaunchOnExitBox"
                          Content="安装完成后启动 RocoPilot"
                          Margin="0,12,0,0"
                          IsChecked="True"
                          FontSize="14" />
                <CheckBox x:Name="InterceptionBox"
                          Content="安装 Interception 内核驱动"
                          Margin="0,12,0,0"
                          IsChecked="True"
                          FontSize="14"
                          Visibility="Collapsed" />
                <TextBlock x:Name="InterceptionHint"
                           Margin="28,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="输入模拟需要，安装后重启生效"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>