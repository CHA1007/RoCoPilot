<ui:FluentWindow x:Class="RocoPilot.Setup.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RocoPilot.Setup.Views"
                 Title="RocoPilot 安装向导"
                 Width="760" Height="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource FillColorTertiaryBrush}">
            <StackPanel Margin="24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/icon.png"
                           Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="RocoPilot"
                               Margin="12,0,0,0"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Margin="0,40,0,0">
                    <Grid x:Name="Step1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step1Badge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White" FontSize="12" Text="1" />
                        </Border>
                        <TextBlock x:Name="Step1Text" Grid.Column="1" Margin="12,0,0,0" Text="欢迎"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <Grid x:Name="Step2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step2Badge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="2" />
                        </Border>
                        <TextBlock x:Name="Step2Text" Grid.Column="1" Margin="12,0,0,0" Text="选项"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid x:Name="Step3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step3Badge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="3" />
                        </Border>
                        <TextBlock x:Name="Step3Text" Grid.Column="1" Margin="12,0,0,0" Text="安装"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid x:Name="Step4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Step4Badge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Text="4" />
                        </Border>
                        <TextBlock x:Name="Step4Text" Grid.Column="1" Margin="12,0,0,0" Text="完成"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="0" />

            <Border Grid.Row="1" Padding="24,12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Grid.Column="0"
                            Content="取消" MinWidth="96"
                            Click="Cancel_Click" />
                    <Button x:Name="BackButton" Grid.Column="2"
                            Content="上一步" MinWidth="96" Margin="0,0,8,0"
                            Click="Back_Click" />
                    <ui:Button x:Name="NextButton" Grid.Column="3"
                            Content="下一步" MinWidth="96" Appearance="Primary"
                            Click="Next_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>