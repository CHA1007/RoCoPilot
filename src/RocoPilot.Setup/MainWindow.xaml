<ui:FluentWindow x:Class="RocoPilot.Setup.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RocoPilot.Setup.Views"
                 Title="RocoPilot 安装向导"
                 Width="540" Height="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="PageHost" Grid.Row="0" />

        <Border Grid.Row="1" Padding="24,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0"
                        Content="取消" MinWidth="96"
                        Click="Cancel_Click" />
                <Button x:Name="BackButton" Grid.Column="2"
                        Content="上一步" MinWidth="96" Margin="0,0,8,0"
                        Click="Back_Click" />
                <ui:Button x:Name="NextButton" Grid.Column="3"
                        Content="下一步" MinWidth="96" Appearance="Primary"
                        Click="Next_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
