<UserControl x:Class="RocoPilot.Tools.AutoThrow.AutoThrowConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel>

    <ui:CardControl Margin="0,0,0,12" VerticalContentAlignment="Top" Padding="16,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="捕捉的精灵对象" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="填写需要捕捉的精灵，为空捕捉所有识别到的精灵"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <StackPanel>
        <StackPanel x:Name="WhitelistHost" Margin="0,0,0,8" />
        <ui:Button HorizontalAlignment="Right"
                   Content="添加精灵名"
                   Icon="{ui:SymbolIcon Add24}"
                   Click="OnAddWhitelistClick" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="蓄力投掷时间（毫秒）" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="长按到松手的时长。实测极短即可，一般保持默认。"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <ui:NumberBox Width="140"
                    Minimum="10"
                    Maximum="3000"
                    SmallChange="10"
                    MaxDecimalPlaces="0"
                    ValidationMode="InvalidInputOverwritten"
                    Value="{Binding ChargeMs}"
                    ValueChanged="OnEditCommitted" />
    </ui:CardControl>

  </StackPanel>
</UserControl>
