<UserControl x:Class="RocoPilot.Tools.AutoThrow.AutoThrowConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel>

    <ui:CardControl Margin="0,0,0,12" VerticalContentAlignment="Top" Padding="16,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="捕捉的精灵对象" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        FontTypography="Caption"
                        Text="留空捕捉全部；目前仅识别恶魔狼、月牙雪熊"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <StackPanel>
        <StackPanel x:Name="WhitelistHost" Margin="0,0,0,8" />
        <ui:Button HorizontalAlignment="Right"
                   Content="添加精灵名"
                   Icon="{ui:SymbolIcon Add24}"
                   Click="OnAddWhitelistClick" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="识别置信度阈值" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        FontTypography="Caption"
                        Text="越低识别越宽松，但也越容易误判"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <ui:NumberBox Width="200"
                    Minimum="0"
                    Maximum="1"
                    SmallChange="0.05"
                    MaxDecimalPlaces="2"
                    ValidationMode="InvalidInputOverwritten"
                    Value="{Binding DetectionConfidence}" />
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="推理设备" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        FontTypography="Caption"
                        Text="一般情况下GPU效率更快，CPU 兼容好"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <ComboBox Width="200"
                SelectedValuePath="Tag"
                SelectedValue="{Binding InferenceDevice}">
        <ComboBoxItem Content="CPU" Tag="cpu" />
        <ComboBoxItem Content="GPU (DirectML)" Tag="gpu" />
      </ComboBox>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="触发器间隔（ms）" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        FontTypography="Caption"
                        Text="两次触发判断之间的等待间隔，间隔越短，目标出现后出手越快"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <ui:NumberBox Width="200"
                    Minimum="0"
                    Maximum="5000"
                    SmallChange="50"
                    MaxDecimalPlaces="0"
                    ValidationMode="InvalidInputOverwritten"
                    Value="{Binding DetectionIntervalMs}" />
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="蓄力投掷时间（ms）" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        FontTypography="Caption"
                        Text="按住左键蓄力投掷咕噜球的时长"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <ui:NumberBox Width="200"
                    Minimum="10"
                    Maximum="3000"
                    SmallChange="10"
                    MaxDecimalPlaces="0"
                    ValidationMode="InvalidInputOverwritten"
                    Value="{Binding ChargeMs}" />
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,12">
      <ui:CardControl.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:TextBlock Grid.Row="0" FontTypography="BodyStrong" Text="投掷前灵敏度校准" TextWrapping="Wrap" />
          <ui:TextBlock Grid.Row="1"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        FontTypography="Caption"
                        Text="开启后每次启动都会进行灵敏度校准"
                        TextWrapping="Wrap" />
        </Grid>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CalibrateBeforeThrow}" />
    </ui:CardControl>

  </StackPanel>
</UserControl>
