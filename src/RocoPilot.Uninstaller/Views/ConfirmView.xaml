<UserControl x:Class="RocoPilot.Uninstaller.Views.ConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="560">
    <StackPanel Margin="40,32" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="/icon.png"
               Width="96" Height="96"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="卸载 RocoPilot"
                   Margin="0,24,0,0"
                   FontSize="28" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="DetailText"
                   Margin="0,8,0,0"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Margin="0,28,0,0"
                   Text="将从你的电脑中移除 RocoPilot 及其相关文件、快捷方式和注册表信息。"
                   TextWrapping="Wrap"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <CheckBox x:Name="DeleteUserDataBox"
                  Margin="0,20,0,0"
                  Content="同时删除个人数据（设置、路线、脚本）"
                  FontSize="14"
                  HorizontalAlignment="Center" />

        <CheckBox x:Name="UninstallDriverBox"
                  Margin="0,12,0,0"
                  Content="同时卸载内核驱动（Interception）"
                  FontSize="14"
                  HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
